    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.0",
    "ajv": "8.20.0",
    "typescript": "5.6.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "katex": "0.19.1"
  },
  "dependencies": {
    "mafs": "0.21.0",
    "pixi.js": "8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
