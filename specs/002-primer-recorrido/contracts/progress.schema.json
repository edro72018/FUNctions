{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://functions.local/contracts/002/progress.schema.json",
  "$comment": "Progreso local del primer recorrido. Versión 1. Propuesta para revisión del plan. El origen de la validación no se persiste.",
  "title": "ProgressV1",
  "description": "Estado persistido en LocalStorage bajo la clave functions.progress.v1. Sin datos personales ni sincronización remota.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mission",
    "flow",
    "completedExerciseIds",
    "activeExerciseId",
    "drafts",
    "attempts",
    "preferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Versión exacta del esquema. Una versión distinta se trata como desconocida y no se sobrescribe."
    },
    "mission": {
      "$ref": "#/$defs/mission"
    },
    "flow": {
      "$ref": "#/$defs/flow"
    },
    "completedExerciseIds": {
      "type": "array",
      "description": "Niveles resueltos del recorrido de prueba, en orden estable E01, E08.",
      "uniqueItems": true,
      "maxItems": 2,
      "items": {
        "enum": ["E01", "E08"]
      }
    },
    "activeExerciseId": {
      "description": "Ejercicio activo; null en la introducción y al completar el recorrido.",
      "enum": ["E01", "E08", null]
    },
    "drafts": {
      "type": "object",
      "description": "Borradores confirmados por ejercicio. El texto transitorio no se persiste.",
      "additionalProperties": false,
      "properties": {
        "E01": {
          "$ref": "#/$defs/e01Draft"
        },
        "E08": {
          "$ref": "#/$defs/e08Draft"
        }
      }
    },
    "attempts": {
      "type": "array",
      "description": "Intentos matemáticos evaluados. Solo correct e incorrect. Sin origen, respuesta ni datos personales.",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "preferences": {
      "type": "object",
      "description": "Objeto reservado. En la versión 1 se persiste vacío; una preferencia nueva requiere nueva versión.",
      "maxProperties": 0,
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "flow": {
            "type": "object",
            "properties": {
              "step": {
                "const": "intro"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "completedExerciseIds": {
            "const": []
          },
          "activeExerciseId": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "flow": {
            "type": "object",
            "properties": {
              "step": {
                "const": "E01"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "completedExerciseIds": {
            "const": []
          },
          "activeExerciseId": {
            "const": "E01"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "flow": {
            "type": "object",
            "properties": {
              "step": {
                "const": "E08"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "completedExerciseIds": {
            "const": ["E01"]
          },
          "activeExerciseId": {
            "const": "E08"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "flow": {
            "type": "object",
            "properties": {
              "step": {
                "const": "complete"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "completedExerciseIds": {
            "const": ["E01", "E08"]
          },
          "activeExerciseId": {
            "const": null
          }
        }
      }
    }
  ],
  "$defs": {
    "exactNumber": {
      "type": "string",
      "description": "Entero, decimal finito o racional exacto de la gramática de 001. Sin exponente, coma decimal ni signo + inicial.",
      "oneOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)$"
        },
        {
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]+$"
        },
        {
          "pattern": "^-?(0|[1-9][0-9]*)/[1-9][0-9]*$"
        }
      ]
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missionId", "startedAt", "lastSavedAt"],
      "properties": {
        "missionId": {
          "type": "string",
          "format": "uuid",
          "description": "UUID v4 local. No es credencial ni identifica a una persona."
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastSavedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step"],
      "properties": {
        "step": {
          "enum": ["intro", "E01", "E08", "complete"],
          "description": "Paso del recorrido de prueba. complete no equivale a victoria 15/15 ni a Zona 3 completa."
        }
      }
    },
    "e01Draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selection", "maxHint"],
      "properties": {
        "kind": {
          "const": "boolean"
        },
        "selection": {
          "description": "true = Es función; false = No es función; null = sin selección.",
          "type": ["boolean", "null"]
        },
        "maxHint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "e08Draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "h", "k", "maxHint"],
      "properties": {
        "kind": {
          "const": "vertex"
        },
        "h": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "k": {
          "oneOf": [
            {
              "$ref": "#/$defs/exactNumber"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxHint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseId", "result", "feedbackCode", "at"],
      "properties": {
        "exerciseId": {
          "enum": ["E01", "E08"]
        },
        "result": {
          "enum": ["correct", "incorrect"]
        },
        "feedbackCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
